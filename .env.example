# Server
HTTP_PORT=8080
GRPC_PORT=50051
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://user:password@localhost:5432/myapp?sslmode=disable
DB_MAX_CONNS=10

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGO=HS256
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Bcrypt
BCRYPT_COST=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
